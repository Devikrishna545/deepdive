# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# --- Mesh API (mandatory: every LLM / embedding call goes through Mesh) ---
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1

# --- Credit protection (USD). Balance comes from Mesh GET /v1/balance ---
LOW_BALANCE_ALERT_USD=5.0     # banner in the UI, warning in logs, /api/health, run trail
MIN_BALANCE_STOP_USD=1.0      # new runs and uploads are refused below this
RUN_BUDGET_USD=0.15           # one run stops if it costs more than this (live Mesh prices)
RUN_TOKEN_BUDGET=250000       # fallback guard if prices can't be loaded

# --- Models: check ids and live prices first, for free: python -m scripts.mesh_account ---
# Cheap model where volume is high; the stronger model only where accuracy is decided.
MODEL_PLANNER=openai/gpt-oss-120b
MODEL_PLANNER_FALLBACK=openai/gpt-5-nano
PLANNER_REASONING_EFFORT=low
MODEL_RESEARCHER=openai/gpt-4o-mini
MODEL_DRAFTER=openai/gpt-4o-mini
# Verifier: different model family from the drafter, and the main cost lever (one call per claim)
MODEL_VERIFIER=anthropic/claude-haiku-4.5
MODEL_SYNTHESIZER=openai/gpt-4o-mini
# Eval-only judge; must differ from the verifier
MODEL_JUDGE=google/gemini-2.5-flash
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Web search (not an LLM). Tavily if set, else DuckDuckGo ---
# Recommended: DuckDuckGo often rate-limits ("No results found"). Free Tavily key, no card:
# https://app.tavily.com (1,000 credits/month; basic search = 1 credit, advanced = 2).
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# --- Pipeline knobs (each trades credits for coverage) ---
MAX_SUBQUESTIONS=4
MAX_LOOPS=1
MIN_SUPPORTED_CLAIMS=2
MIN_DISTINCT_DOMAINS=2
RESULTS_PER_QUERY=4
MAX_PAGES_PER_SUBQUESTION=4
CHUNKS_PER_SUBQUESTION=10
MAX_CONCURRENCY=4
FETCH_TIMEOUT_S=10
# Ablation switch for self-evaluation: false = skip verification
VERIFY_ENABLED=true
# Reuse the plan for a repeated question (saves the planner call; keeps benchmark runs comparable)
CACHE_PLANS=true

# --- Developer views: per-agent token usage tab + /dev/usage page. Set false for the demo ---
DEV_MODE=true

# --- Storage ---
DATABASE_URL=sqlite:///data/deepdive.db
